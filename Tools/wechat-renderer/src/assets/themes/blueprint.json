{
  "id": "blueprint",
  "version": "1.2.1",
  "styles": {
    "root": "box-sizing:border-box;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Hiragino Sans GB','Microsoft YaHei',sans-serif;background:#ffffff;color:#20242c;max-width:700px;margin:0 auto;padding:22px 20px;font-size:15px;line-height:1.9;overflow-wrap:break-word;",
    "paragraph": "margin:16px 0;color:#20242c;font-size:15px;line-height:1.9;letter-spacing:0;",
    "h1": "margin:32px 0 18px;color:#20242c;font-size:20px;line-height:1.45;font-weight:700;letter-spacing:0;",
    "h2": "margin:48px 0 18px;color:#161c28;font-size:20px;line-height:1.45;font-weight:700;letter-spacing:0;",
    "h3": "margin:28px 0 14px;color:#20242c;font-size:16px;line-height:1.5;font-weight:700;letter-spacing:0;",
    "h4": "margin:24px 0 12px;color:#20242c;font-size:15px;line-height:1.5;font-weight:700;letter-spacing:0;",
    "h5": "margin:22px 0 12px;color:#20242c;font-size:15px;line-height:1.5;font-weight:700;letter-spacing:0;",
    "h6": "margin:22px 0 12px;color:#6b737b;font-size:15px;line-height:1.5;font-weight:700;letter-spacing:0;",
    "strong": "color:#2455d6;font-weight:700;",
    "em": "color:#6b737b;font-style:italic;",
    "link": "color:#2455d6;text-decoration:none;border-bottom:1px solid #2455d6;padding-bottom:1px;overflow-wrap:anywhere;",
    "underline": "border-bottom:2px solid #a9bce9;padding-bottom:1px;color:#20242c;font-weight:600;",
    "highlight": "background:#e2ebff;padding:1px 2px;border-bottom:1px solid #6e94e8;color:#20242c;font-weight:600;",
    "warning": "background:#fff1bf;padding:1px 2px;border-radius:2px;color:#20242c;font-weight:600;",
    "red": "color:#8f1d22;font-weight:700;",
    "strike": "color:#737b83;text-decoration:line-through;",
    "videoCard": "margin:24px 0;padding:18px 16px;border:1px dashed #a9bce9;background:#f6f8fc;",
    "videoLabel": "margin:0 0 8px;color:#2455d6;font-size:12px;line-height:1.5;font-weight:600;",
    "videoTitle": "margin:0 0 10px;color:#20242c;font-size:15px;line-height:1.6;font-weight:700;",
    "videoNote": "margin:0 0 8px;color:#737b83;font-size:13px;line-height:1.7;letter-spacing:0;",
    "videoSource": "margin:0;color:#737b83;font-size:12px;line-height:1.7;overflow-wrap:anywhere;word-break:break-all;text-decoration:none;",
    "figure": "margin:24px 0;",
    "image": "box-sizing:border-box;width:100%;max-width:100%;height:auto;display:block;",
    "caption": "margin:8px 0 0;color:#737b83;font-size:12px;line-height:1.65;letter-spacing:0;text-align:center;",
    "quote": "margin:26px 0;padding:2px 0 2px 18px;border-left:2px solid #2455d6;",
    "quoteParagraph": "margin:8px 0;color:#465166;font-size:15px;line-height:1.9;letter-spacing:0;",
    "callout": "margin:26px 0;padding:16px 18px;background:#f4f7ff;border-left:2px solid #2455d6;",
    "calloutTitle": "margin:0 0 8px;color:#2455d6;font-size:14px;line-height:1.6;font-weight:700;letter-spacing:0;",
    "end": "margin:56px 0 18px;",
    "list": "margin:16px 0;padding-left:24px;color:#20242c;font-size:15px;line-height:1.9;letter-spacing:0;",
    "listItem": "margin:8px 0;",
    "codeWrap": "margin:24px 0;border:1px solid #dce3f0;border-radius:8px;overflow:hidden;background:#f5f7fa;",
    "codeHeader": "display:flex;align-items:center;justify-content:space-between;min-height:38px;padding:12px 14px;background:#edf2fa;border-bottom:1px solid #dce3f0;line-height:1;",
    "codeDots": "white-space:nowrap;font-family:Arial,sans-serif;font-size:18px;line-height:12px;letter-spacing:0;",
    "codeDot": "font-family:Arial,sans-serif;font-size:18px;line-height:12px;font-weight:400;letter-spacing:0;",
    "codeDotRed": "color:#ff5f57;margin-right:6px;",
    "codeDotYellow": "color:#febc2e;margin-right:6px;",
    "codeDotGreen": "color:#28c840;",
    "codeLang": "margin-left:14px;font-family:'SFMono-Regular',Menlo,Consolas,'Courier New',monospace;color:#2455d6;font-size:11px;line-height:1.2;letter-spacing:0;",
    "pre": "margin:0;padding:14px 16px;background:#f5f7fa;overflow-x:auto;white-space:pre;letter-spacing:0;",
    "code": "font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Hiragino Sans GB','Microsoft YaHei',sans-serif;font-size:15px;line-height:1.8;color:#20242c;white-space:pre;letter-spacing:0;",
    "inlineCode": "font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Hiragino Sans GB','Microsoft YaHei',sans-serif;font-size:15px;color:#20242c;background:#eef0f2;padding:1px 4px;border-radius:2px;letter-spacing:0;overflow-wrap:anywhere;",
    "hr": "margin:36px 0;border:0;border-top:1px solid #dce3f0;",
    "tableWrap": "margin:24px 0;overflow-x:auto;",
    "table": "width:100%;border-collapse:collapse;font-size:15px;line-height:1.9;",
    "th": "padding:10px 12px;border:1px solid #dce3f0;background:#edf2ff;color:#20242c;font-weight:700;text-align:left;",
    "td": "padding:10px 12px;border:1px solid #dce3f0;color:#20242c;text-align:left;",
    "headingNumber": "display:inline-block;color:#2455d6;font-size:15px;line-height:1.2;font-weight:600;letter-spacing:0;margin-right:12px;padding-right:12px;border-right:1px solid #d9dfeb;vertical-align:1px;",
    "tocWrap": "margin:28px 0;border:1px solid #dce3f0;border-radius:8px;overflow:hidden;background:#f6f8fc;",
    "tocTitle": "margin:0;padding:14px 16px;border-bottom:1px solid #dce3f0;color:#2455d6;font-size:13px;line-height:1.5;font-weight:700;",
    "tocScroll": "height:132px;overflow-y:auto;overscroll-behavior:contain;scrollbar-gutter:stable;padding:4px 16px;",
    "tocLink": "display:flex;align-items:baseline;margin:0;padding:10px 0;color:#384152;text-decoration:none;font-size:14px;line-height:1.6;letter-spacing:0;",
    "tocNumber": "flex:0 0 auto;min-width:32px;margin-right:12px;padding-right:10px;border-right:1px solid #dce3f0;color:#2455d6;font-size:12px;line-height:1.3;font-weight:600;",
    "tocText": "min-width:0;overflow-wrap:anywhere;",
    "scrollQuote": "margin:26px 0;border:1px solid #dce3f0;border-radius:8px;overflow:hidden;background:#f6f8fc;",
    "scrollQuoteLabel": "margin:0;padding:10px 16px;border-bottom:1px solid #dce3f0;color:#737b83;font-size:12px;line-height:1.6;",
    "scrollQuoteBody": "height:240px;overflow-y:auto;overscroll-behavior:contain;-webkit-overflow-scrolling:touch;scrollbar-gutter:stable;padding:4px 16px;"
  },
  "name": "蓝图档案",
  "codePresentation": "macos",
  "preview": {
    "accent": "#2455d6",
    "hover": "#edf2ff",
    "paper": "white",
