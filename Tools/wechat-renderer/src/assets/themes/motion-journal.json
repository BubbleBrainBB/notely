{
  "id": "motion-journal",
  "version": "1.0.8",
  "styles": {
    "root": "box-sizing:border-box;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Hiragino Sans GB','Microsoft YaHei',sans-serif;background:#fbfcf8;color:#222920;max-width:700px;margin:0 auto;padding:32px 24px;font-size:15px;line-height:1.95;overflow-wrap:break-word;",
    "paragraph": "margin:18px 0;color:#222920;font-size:15px;line-height:1.95;letter-spacing:0;",
    "h1": "margin:40px 0 22px;color:#17211b;font-size:32px;line-height:1.3;font-weight:750;letter-spacing:-1px;",
    "h2": "margin:64px 0 24px;padding-top:18px;border-top:1px solid #cfd6c5;color:#17211b;font-size:23px;line-height:1.4;font-weight:750;letter-spacing:-0.3px;",
    "h3": "margin:34px 0 14px;color:#17211b;font-size:19px;line-height:1.5;font-weight:700;padding-left:6px;",
    "h4": "font-family:'Songti SC','STSong','SimSun','Noto Serif CJK SC',serif;margin:26px 0 14px;color:#38352f;font-size:17px;line-height:1.6;font-weight:600;",
    "h5": "margin:24px 0 12px;color:#38352f;font-size:15px;line-height:1.6;font-weight:700;",
    "h6": "margin:22px 0 12px;color:#827a70;font-size:15px;line-height:1.6;font-weight:600;",
    "strong": "color:#344a1b;font-weight:750;",
    "em": "color:#827a70;font-style:italic;",
    "link": "color:#435924;text-decoration:none;border-bottom:1px solid #435924;padding-bottom:1px;overflow-wrap:anywhere;",
    "underline": "border-bottom:2px solid #bdcba1;padding-bottom:1px;color:#222920;font-weight:600;",
    "highlight": "background:#e9f1d2;padding:1px 2px;color:#222920;font-weight:600;",
    "warning": "background:#fff1bf;padding:1px 2px;border-radius:2px;color:#222920;font-weight:600;",
    "red": "color:#bd3038;font-weight:700;",
    "strike": "color:#827a70;text-decoration:line-through;",
    "videoCard": "margin:24px 0;padding:18px 16px;border:1px dashed #d8b9aa;background:#faf7f1;",
    "videoLabel": "margin:0 0 8px;color:#435924;font-size:12px;line-height:1.5;font-weight:600;",
    "videoTitle": "margin:0 0 10px;color:#222920;font-size:15px;line-height:1.6;font-weight:700;",
    "videoNote": "margin:0 0 8px;color:#827a70;font-size:13px;line-height:1.7;letter-spacing:0;",
    "videoSource": "margin:0;color:#827a70;font-size:12px;line-height:1.7;overflow-wrap:anywhere;word-break:break-all;text-decoration:none;",
    "figure": "margin:34px 0;",
    "image": "box-sizing:border-box;width:100%;max-width:100%;height:auto;display:block;",
    "caption": "margin:10px 0 0;color:#66705e;font-size:12px;line-height:1.7;text-align:center;",
    "quote": "margin:30px 0;padding:18px 22px 20px;border:0;border-radius:4px;background:#eef1e8;",
    "quoteParagraph": "margin:8px 0;color:#46513f;font-size:15px;line-height:1.95;",
    "callout": "margin:32px 0;padding:18px 20px;background:#e9f1d2;",
    "calloutTitle": "margin:0 0 8px;color:#344a1b;font-size:13px;line-height:1.7;font-weight:700;",
    "end": "margin:48px 0 18px;",
    "list": "margin:16px 0;padding-left:24px;color:#222920;font-size:15px;line-height:1.95;letter-spacing:0;",
    "listItem": "margin:8px 0;",
    "codeWrap": "margin:28px 0;border:0;border-radius:0;background:transparent;",
    "codeHeader": "margin:0;padding:0;border:0;background:transparent;line-height:1;",
    "codeDots": "white-space:nowrap;font-family:Arial,sans-serif;font-size:11px;line-height:10px;letter-spacing:0;",
    "codeDot": "font-family:Arial,sans-serif;font-size:11px;line-height:10px;font-weight:400;letter-spacing:0;",
    "codeDotRed": "color:#ff5f57;margin-right:4px;",
    "codeDotYellow": "color:#febc2e;margin-right:4px;",
    "codeDotGreen": "color:#28c840;",
    "codeLang": "display:inline-block;max-width:100%;box-sizing:border-box;overflow-wrap:anywhere;padding:8px 15px;margin:0;border:1px solid #c5cfb6;border-bottom:0;background:#dfe6d2;color:#4a5a38;font-size:11px;line-height:1.2;letter-spacing:1px;font-weight:600;",
    "pre": "margin:0;padding:16px 18px 18px;border:1px solid #c5cfb6;background:#f0f3e9;overflow-x:auto;white-space:pre;letter-spacing:0;",
    "code": "font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Hiragino Sans GB','Microsoft YaHei',sans-serif;font-size:15px;line-height:1.8;color:#222920;white-space:pre;letter-spacing:0;",
    "inlineCode": "font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Hiragino Sans GB','Microsoft YaHei',sans-serif;font-size:15px;color:#222920;background:#e9ede3;padding:1px 4px;border-radius:2px;overflow-wrap:anywhere;",
    "hr": "margin:44px 0;border:0;border-top:1px solid #cfd6c5;",
    "tableWrap": "margin:24px 0;overflow-x:auto;",
    "table": "width:100%;table-layout:auto;border:0;border-collapse:collapse;border-spacing:0;background:transparent;font-size:15px;line-height:1.9;",
    "th": "width:auto;border:0;background:transparent;padding:12px 10px;border-bottom:1px solid #cec5b8;color:#514c45;font-size:13px;font-weight:600;text-align:left;",
    "td": "width:auto;border:0;background:transparent;padding:12px 10px;border-bottom:1px solid #e3ded5;color:#222920;text-align:left;",
    "tocWrap": "margin:28px 0;border:1px solid #e3ded5;border-radius:8px;overflow:hidden;background:#faf7f1;",
    "tocTitle": "margin:0;padding:14px 16px;border-bottom:1px solid #e3ded5;color:#435924;font-size:13px;line-height:1.5;font-weight:700;",
    "tocScroll": "height:132px;overflow-y:auto;overscroll-behavior:contain;scrollbar-gutter:stable;padding:4px 16px;",
    "tocLink": "display:flex;align-items:baseline;margin:0;padding:10px 0;color:#514c45;text-decoration:none;font-size:14px;line-height:1.6;letter-spacing:0;",
    "tocNumber": "flex:0 0 auto;min-width:32px;margin-right:12px;padding-right:10px;border-right:1px solid #e3ded5;color:#435924;font-size:12px;line-height:1.3;font-weight:600;",
    "tocText": "min-width:0;overflow-wrap:anywhere;",
    "tableSection": "border:0;background:transparent;",
    "tableRow": "border:0;background:transparent;",
    "headingNumber": "display:inline-block;margin:0 18px 0 0;color:#8a9679;font-family:Arial,sans-serif;font-size:64px;line-height:1;font-weight:400;letter-spacing:-4px;font-style:italic;vertical-align:baseline;",
    "quoteMark": "display:block;height:26px;margin:0 0 6px;color:#99a88a;font-family:Georgia,'Times New Roman',serif;font-size:44px;line-height:1;font-weight:400;",
    "h3Marker": "display:inline-block;margin-right:10px;color:#8a9679;font-family:Arial,sans-serif;font-size:17px;line-height:1;font-weight:400;"
  },
  "name": "动态实验刊",
  "codePresentation": "index-card",
  "preview": {
    "accent": "#435924",
    "hover": "#eef3e4",
    "paper": "#fbfcf8",
    "titleStyle": "font-size:30px;line-height:1.35;letter-spacing:-1px;font-weight:750;color:#17211b;"
  },
  "headingNumbered": true,
  "h3MarkerText": "↳"
}
