{
  "id": "songti-supplement",
  "version": "1.0.6",
  "styles": {
    "root": "box-sizing:border-box;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Hiragino Sans GB','Microsoft YaHei',sans-serif;background:#f5f5f5;color:#30302c;max-width:700px;margin:0 auto;padding:24px 22px;font-size:15px;line-height:1.95;overflow-wrap:break-word;",
    "paragraph": "margin:18px 0;color:#30302c;font-size:15px;line-height:1.95;letter-spacing:0.1px;",
    "h1": "font-family:'Songti SC','STSong','SimSun','Noto Serif CJK SC',serif;margin:40px 0 24px;color:#242420;font-size:28px;line-height:1.5;font-weight:600;letter-spacing:0.5px;",
    "h2": "font-family:'Songti SC','STSong','SimSun','Noto Serif CJK SC',serif;margin:48px 0 20px;color:#bd3038;font-size:24px;line-height:1.5;font-weight:600;letter-spacing:0.5px;",
    "h3": "font-family:'Songti SC','STSong','SimSun','Noto Serif CJK SC',serif;margin:30px 0 16px;color:#38352f;font-size:19px;line-height:1.6;font-weight:600;letter-spacing:0.3px;",
    "h4": "font-family:'Songti SC','STSong','SimSun','Noto Serif CJK SC',serif;margin:26px 0 14px;color:#38352f;font-size:17px;line-height:1.6;font-weight:600;",
    "h5": "margin:24px 0 12px;color:#38352f;font-size:15px;line-height:1.6;font-weight:700;",
    "h6": "margin:22px 0 12px;color:#827a70;font-size:15px;line-height:1.6;font-weight:600;",
    "strong": "color:#242420;font-weight:700;",
    "em": "color:#827a70;font-style:italic;",
    "link": "color:#bd3038;text-decoration:none;border-bottom:1px solid #bd3038;padding-bottom:1px;overflow-wrap:anywhere;",
    "underline": "border-bottom:2px solid #dbaab0;padding-bottom:1px;color:#30302c;font-weight:600;",
    "highlight": "background:#f8e6e8;padding:1px 2px;color:#30302c;font-weight:600;",
    "warning": "background:#fff1bf;padding:1px 2px;border-radius:2px;color:#30302c;font-weight:600;",
    "red": "color:#bd3038;font-weight:700;",
    "strike": "color:#827a70;text-decoration:line-through;",
    "videoCard": "margin:24px 0;padding:18px 16px;border:1px dashed #d8b9aa;background:#faf7f1;",
    "videoLabel": "margin:0 0 8px;color:#bd3038;font-size:12px;line-height:1.5;font-weight:600;",
    "videoTitle": "margin:0 0 10px;color:#30302c;font-size:15px;line-height:1.6;font-weight:700;",
    "videoNote": "margin:0 0 8px;color:#827a70;font-size:13px;line-height:1.7;letter-spacing:0;",
    "videoSource": "margin:0;color:#827a70;font-size:12px;line-height:1.7;overflow-wrap:anywhere;word-break:break-all;text-decoration:none;",
    "figure": "margin:32px 0;",
    "image": "box-sizing:border-box;width:100%;max-width:100%;height:auto;display:block;",
    "caption": "margin:10px 0 0;color:#827a70;font-size:12px;line-height:1.7;letter-spacing:0.2px;text-align:center;",
    "quote": "margin:34px 20px;padding:0;",
    "quoteParagraph": "font-family:'Songti SC','STSong','SimSun','Noto Serif CJK SC',serif;margin:12px 0;color:#756b5e;font-size:15px;line-height:1.95;letter-spacing:0.3px;",
    "callout": "margin:32px 18px;padding:0;",
    "calloutTitle": "font-family:'Songti SC','STSong','SimSun','Noto Serif CJK SC',serif;margin:0 0 10px;color:#bd3038;font-size:17px;line-height:1.6;font-weight:600;",
    "end": "margin:48px 0 18px;",
    "list": "margin:16px 0;padding-left:24px;color:#30302c;font-size:15px;line-height:1.95;letter-spacing:0;",
    "listItem": "margin:8px 0;",
    "codeWrap": "margin:26px 0;border:1px solid #e3ded5;border-radius:8px;overflow:hidden;background:#faf8f4;",
    "codeHeader": "display:flex;align-items:center;justify-content:space-between;min-height:38px;padding:12px 14px;background:#f1ede6;border-bottom:1px solid #e3ded5;line-height:1;",
    "codeDots": "white-space:nowrap;font-family:Arial,sans-serif;font-size:18px;line-height:12px;letter-spacing:0;",
    "codeDot": "font-family:Arial,sans-serif;font-size:18px;line-height:12px;font-weight:400;letter-spacing:0;",
    "codeDotRed": "color:#ff5f57;margin-right:6px;",
    "codeDotYellow": "color:#febc2e;margin-right:6px;",
    "codeDotGreen": "color:#28c840;",
    "codeLang": "margin-left:14px;font-family:'SFMono-Regular',Menlo,Consolas,'Courier New',monospace;color:#827a70;font-size:11px;line-height:1.2;letter-spacing:0;",
    "pre": "margin:0;padding:14px 16px;background:#faf8f4;overflow-x:auto;white-space:pre;letter-spacing:0;",
    "code": "font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Hiragino Sans GB','Microsoft YaHei',sans-serif;font-size:15px;line-height:1.8;color:#30302c;white-space:pre;letter-spacing:0;",
    "inlineCode": "font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Hiragino Sans GB','Microsoft YaHei',sans-serif;font-size:15px;color:#30302c;background:#f1ede6;padding:1px 4px;border-radius:2px;letter-spacing:0;overflow-wrap:anywhere;",
    "hr": "margin:36px 0;border:0;border-top:1px solid #e3ded5;",
    "tableWrap": "margin:24px 0;overflow-x:auto;",
    "table": "width:100%;table-layout:auto;border:0;border-collapse:collapse;border-spacing:0;background:transparent;font-size:15px;line-height:1.9;",
    "th": "width:auto;border:0;background:transparent;padding:12px 10px;border-bottom:1px solid #cec5b8;color:#514c45;font-size:13px;font-weight:600;text-align:left;",
    "td": "width:auto;border:0;background:transparent;padding:12px 10px;border-bottom:1px solid #e3ded5;color:#30302c;text-align:left;",
    "tocWrap": "margin:28px 0;border:1px solid #e3ded5;border-radius:8px;overflow:hidden;background:#faf7f1;",
    "tocTitle": "margin:0;padding:14px 16px;border-bottom:1px solid #e3ded5;color:#bd3038;font-size:13px;line-height:1.5;font-weight:700;",
    "tocScroll": "height:132px;overflow-y:auto;overscroll-behavior:contain;scrollbar-gutter:stable;padding:4px 16px;",
    "tocLink": "display:flex;align-items:baseline;margin:0;padding:10px 0;color:#514c45;text-decoration:none;font-size:14px;line-height:1.6;letter-spacing:0;",
    "tocNumber": "flex:0 0 auto;min-width:32px;margin-right:12px;padding-right:10px;border-right:1px solid #e3ded5;color:#bd3038;font-size:12px;line-height:1.3;font-weight:600;",
    "tocText": "min-width:0;overflow-wrap:anywhere;",
    "tableSection": "border:0;background:transparent;",
    "tableRow": "border:0;background:transparent;"
  },
  "name": "宋体副刊",
  "codePresentation": "macos",
  "preview": {
    "accent": "#bd3038",
    "hover": "#f4ede6",
    "paper": "#f5f5f5",
    "titleStyle": "font-family:'Songti SC','STSong','SimSun','Noto Serif CJK SC',serif;font-size:26px;font-weight:600;letter-spacing:0.5px;"
  },
  "headingNumbered": false
}
